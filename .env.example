# Neon Postgres. The Vercel Marketplace integration sets this for you.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Protects /api/cron/* routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
